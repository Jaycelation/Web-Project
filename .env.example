# PostgreSQL
POSTGRES_DB=secure_commerce
POSTGRES_USER=secure_commerce
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://secure_commerce:change-me-in-production@localhost:5432/secure_commerce?schema=public

# API
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Safety latch: seed demo bị chặn trong production trừ khi bật rõ ràng.
ALLOW_DEMO_SEED=false
# Production còn yêu cầu WEB_ORIGIN=https://... chính xác, secret không phải giá trị mẫu,
# COOKIE_SECURE=true, CRYPTO_AUTO_GENERATE=false và key path được cấp rõ ràng.

# Application-layer encryption. TLS/HTTPS remains mandatory in production.
CRYPTO_KEY_ID=dev-rsa-2026-01
CRYPTO_PRIVATE_KEY_PATH=apps/api/.local/keys/server-private.pem
CRYPTO_PUBLIC_KEY_PATH=apps/api/.local/keys/server-public.pem
CRYPTO_SIGNING_KEY_ID=dev-signing-rsa-2026-01
CRYPTO_SIGNING_PRIVATE_KEY_PATH=apps/api/.local/keys/server-signing-private.pem
CRYPTO_SIGNING_PUBLIC_KEY_PATH=apps/api/.local/keys/server-signing-public.pem
# Migration switch: disable only after telemetry confirms no legacy clients remain.
CRYPTO_ACCEPT_V1=true
CRYPTO_AUTO_GENERATE=true
CRYPTO_MAX_CLOCK_SKEW_MS=120000
CRYPTO_REPLAY_TTL_MS=300000
CRYPTO_RSA_BITS=3072

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1
# Optional SPKI SHA-256 pin. Leave blank in development; set at build time in production.
NEXT_PUBLIC_CRYPTO_SERVER_KEY_SHA256=
# Optional SPKI SHA-256 pin for the distinct response-signing key.
NEXT_PUBLIC_CRYPTO_SIGNING_KEY_SHA256=

# Commerce operations
BASE_SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=1000000
BANK_NAME=Ngân hàng Demo
BANK_ACCOUNT_NUMBER=0000000000
BANK_ACCOUNT_NAME=SECURE COMMERCE

# Public site metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
